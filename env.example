# Copy to .env and fill in. .env is git-ignored.

# --- LLM / VLM / Embedding provider ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o
OPENAI_VLM_MODEL_NAME=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
# Output dimension of the embedding model (text-embedding-3-small = 1536)
EMBEDDING_DIMENSION=1536
LLM_TEMPERATURE=0.2

# --- Neo4j ---
# Inside docker-compose use bolt://neo4j:7687 ; on host use bolt://localhost:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=locus-dev-password

# --- OpenSearch ---
# Inside docker-compose use http://opensearch:9200 ; on host use http://localhost:9200
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=locus_search
# Required by the OpenSearch 2.12+ image at boot (even with the security plugin disabled)
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Locus-dev-Passw0rd!

# --- App ---
LOCUS_DEBUG=false

# --- Docker Compose ports (optional) ---
API_PORT=8000
WEB_PORT=3000
