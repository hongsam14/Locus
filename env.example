# Copy to .env and fill in. .env is git-ignored.

# --- LLM / VLM / Embedding provider ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o
OPENAI_VLM_MODEL_NAME=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
# Output dimension of the embedding model (text-embedding-3-small = 1536)
EMBEDDING_DIMENSION=1536
LLM_TEMPERATURE=0.2

# Copy to .env and fill in the REQUIRED values below. No passwords are hardcoded
# anywhere (no insecure defaults): docker compose fails fast if a required value
# is unset. .env is git-ignored — never commit a filled-in .env.

# --- Neo4j ---
# Inside docker-compose use bolt://neo4j:7687 ; on host use bolt://localhost:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=          # REQUIRED — choose a password (used to init Neo4j + by the app)

# --- OpenSearch ---
# Inside docker-compose use http://opensearch:9200 ; on host use http://localhost:9200
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=locus_search
# Only needed if you enable the OpenSearch security plugin (disabled by default):
# OPENSEARCH_INITIAL_ADMIN_PASSWORD=

# --- PostgreSQL (game-session layer, S1) ---
# Inside docker-compose host=postgres ; on host set SESSION_DB_URL yourself.
SESSION_DB_USER=locus
SESSION_DB_NAME=locus_session
SESSION_DB_PASSWORD=     # REQUIRED — choose a password (used to init Postgres + build the app's URL)
# Host dev (not compose): set the full URL incl. credentials, e.g.
# SESSION_DB_URL=postgresql+psycopg://locus:YOUR_PASSWORD@localhost:5432/locus_session

# --- Rumor dynamics (game-session hardening; all optional, deterministic) ---
# support(공신력) drives rumor survival/propagation/feedback. Defaults shown.
# RUMOR_SUPPORT_DECAY=0.05          # per-turn support loss for unreinforced rumors
# RUMOR_PRUNE_FLOOR=0.05            # support below this -> pruned (soft-flag); promoted exempt
# RUMOR_MIN_SOURCE_SUPPORT=0.3      # min support to re-seed new rumors (auto-append)
# RUMOR_FEEDBACK_WEIGHT=0.1         # rumor->region distortion feedback scale
# RUMOR_HIGH_SUPPORT_THRESHOLD=0.6  # "strong" rumor bar for feedback density
# RUMOR_BIRTH_SUPPORT=0.2           # initial support of a freshly generated rumor
# --- Player mode (U4): movement cost cap, per-turn runaway caps, executor shutdown ---
# PLAY_MAX_MOVE_COST=5              # a move costs clamp(ceil(1/weight), 1, this) turns
# RUMOR_MAX_NEW_PER_REGION_TURN=2   # new rumors a turn may draft per region
# LLM_MAX_CALLS_PER_TURN=8          # LLM budget per turn (one chain degree = one call)
# RUMOR_MAX_ACTIVE_PER_REGION=20    # a turn never pushes a region's active rumors above this
# TURN_SHUTDOWN_TIMEOUT_S=30        # API shutdown waits this long for a running turn
# --- NPC dialogue (U5): what one NPC prompt may carry; all optional ---
# NPC_MAX_FACTS=12                  # canonical facts (direct / inherited / global) of the region
# NPC_MAX_RUMORS=8                  # active rumors of the region (a picked rumor hides its source)
# NPC_MAX_RECENT_MESSAGES=10        # past lines of the conversation replayed into the prompt
# NPC_MAX_MESSAGE_CHARS=500         # a longer player line answers 400
# --- Deeds & spread (U6): appraisal, seeding and one-hop-per-turn spread; all optional ---
# SPREAD_MIN_WEIGHT=0.15            # a hop needs this reach weight (best path x hop)
# DEED_SEED_MIN_SALIENCE=0.5        # a noteworthy judgement below this seeds nothing
# MAX_SPREAD_PER_REGION_TURN=1      # deed-rumor hops a region takes per turn
# DECLARE_MAX_CHARS=300             # a longer declaration answers 400
# NPC_MAX_DEEDS=5                   # deeds in one NPC's dialogue context
# APPRAISAL_MAX_DEEDS=8             # deeds judged in one appraisal call (newest first)

# --- Localization (UX Improvement / X1; all optional) ---
# Translate LLM-generated session content (rumors, events) + canonical Knowledge
# to the target language for display; cached in the session store, reuses the LLM.
# Reads are cache-only (never block); misses warm in the background.
# TRANSLATION_ENABLED=true          # false -> show original English only
# TRANSLATION_TARGET_LANG=ko        # default display language (a request's ?lang= overrides it)
# SUPPORTED_LANGS=ko,en             # ?lang= allow-list (comma list); must contain TRANSLATION_TARGET_LANG

# --- Docker Compose ports (optional) ---
API_PORT=8000
WEB_PORT=3000

# --- Data ---
# LOCUS_DATA_DIR=data               # World File backups land in <LOCUS_DATA_DIR>/backups before a replace (U2)
